# Copy to .env and fill in real values. NEVER commit .env (AGENTS.md §8).

# --- PostgreSQL / TimescaleDB (ADR 0005) ---
POSTGRES_USER=ti_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tachocline
POSTGRES_HOST=db            # Compose service name; use localhost from your Mac shell
POSTGRES_PORT=5432
# Read-only role used by Grafana and the API
TI_READONLY_USER=ti_reader
TI_READONLY_PASSWORD=change-me-too

# --- Grafana (ADR 0007) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana

# --- Ingestion (ADR 0004) ---
INGEST_USER_AGENT="TachoclineIndustries/0.1 (contact: you@example.com)"
SWPC_POLL_MINUTES=5
RAW_DATA_DIR=/data/raw

# --- Optional API keys (later sources; all free) ---
NASA_API_KEY=DEMO_KEY        # https://api.nasa.gov (DONKI)
FIRMS_MAP_KEY=               # https://firms.modaps.eosdis.nasa.gov/api/map_key
SPACETRACK_USER=             # https://www.space-track.org (free account)
SPACETRACK_PASSWORD=
SATNOGS_DB_TOKEN=            # https://db.satnogs.org → Settings/API Key
