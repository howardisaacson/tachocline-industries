# Copy to .env and fill in real values. NEVER commit .env (AGENTS.md §8).

# --- PostgreSQL / TimescaleDB (ADR 0005) ---
POSTGRES_USER=ti_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tachocline
# From the laptop, psql uses localhost and POSTGRES_PORT. Compose publishes
# that port on 127.0.0.1 only. migrate and ingest are pointed at hostname
# `db` and container port 5432 inside docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Read-only login for Grafana and the API (issue #25).
# Local development only. This password is not a production secret.
# db/migrations/0001_solar_wind.sql reads these from the environment
# when migrate creates the role. The password is not stored in git.
# Grafana's datasource (issue #28) logs in as this user. Compose passes
# both values into the grafana container. dashboards/ does not store
# the password. The role has SELECT only.
TI_READONLY_USER=ti_reader
TI_READONLY_PASSWORD=change-me-too

# --- Grafana (ADR 0007) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana
# Host port published on 127.0.0.1. Grafana itself listens on 3000.
GRAFANA_PORT=3000

# --- Ingestion (ADR 0004) ---
# The ingest process reads these three. Every SWPC_POLL_MINUTES it fetches
# the two solar-wind files and the GOES X-ray file (issue #31), writes
# data/raw/swpc_rtsw/<YYYY-MM-DD>/ and data/raw/goes_xray/<YYYY-MM-DD>/,
# then validates and upserts. Both jobs share this interval, so there is
# no second cadence variable. Compose sets POSTGRES_HOST to db for this
# service. The HTTP timeout is 60s in code. The database connection is
# the POSTGRES_* variables above.
INGEST_USER_AGENT="TachoclineIndustries/0.1 (contact: you@example.com)"
SWPC_POLL_MINUTES=5
RAW_DATA_DIR=/data/raw

# --- Optional API keys (later sources; all free) ---
NASA_API_KEY=DEMO_KEY        # https://api.nasa.gov (DONKI)
FIRMS_MAP_KEY=               # https://firms.modaps.eosdis.nasa.gov/api/map_key
SPACETRACK_USER=             # https://www.space-track.org (free account)
SPACETRACK_PASSWORD=
SATNOGS_DB_TOKEN=            # https://db.satnogs.org → Settings/API Key
